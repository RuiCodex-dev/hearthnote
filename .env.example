# Copy to .env (git-ignored). Never commit real values.
LLM_PROVIDER=nebius            # nebius | mock | auto
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# HEARTH_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
# HEARTH_DEEP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
HEARTH_MODE=demo               # demo (per-visitor sandboxes) | private (one encrypted household)
HEARTH_VAULT_KEY=              # private mode: 32-byte base64 or a long passphrase
HEARTH_PASSCODE=               # private mode: passcode the family types once per device
# TAVILY_API_KEY=              # optional: reference lookup for the medication check
# TRUST_PROXY_HEADER=x-real-ip
